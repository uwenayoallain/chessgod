# Copy this file to .env.tunnel and fill in CLOUDFLARE_TUNNEL_TOKEN.
#
# Create a Cloudflare Tunnel in the Cloudflare dashboard and route:
#   chess.uwe.rw -> http://frontend:5173
#
# Then copy the tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Keep frontend API requests same-origin through the tunneled hostname.
VITE_API_URL=

# Allow the public hostname and local dev host.
CORS_ORIGINS=["https://chess.uwe.rw","http://localhost:5173"]

# Local database defaults. Change these before sharing the app widely.
POSTGRES_DB=chessgod
POSTGRES_USER=chessgod
POSTGRES_PASSWORD=chessgod

# Optional: reduce server CPU usage. Browser Stockfish still works.
ANALYSIS_WORKER_ENABLED=true
ANALYSIS_WORKER_THREADS=2
ANALYSIS_WORKER_HASH_MB=512
