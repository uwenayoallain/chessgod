POSTGRES_DB=chessgod
POSTGRES_USER=chessgod
POSTGRES_PASSWORD=chessgod
DATABASE_URL=postgresql+asyncpg://chessgod:chessgod@postgres:5432/chessgod
POSTGRES_PORT=15432
BACKEND_PORT=18000
FRONTEND_PORT=15173
VITE_API_URL=http://localhost:18000
CORS_ORIGINS=["http://localhost:15173"]
LICHESS_EXPLORER_URL=https://explorer.lichess.org
LICHESS_API_TOKEN=
LICHESS_REQUEST_DELAY=0.2
LICHESS_SYNC_MIN_POSITION_GAMES=2
LICHESS_SYNC_MAX_POSITIONS_PER_RUN=100
LICHESS_SYNC_COOLDOWN_AUTH_MINUTES=360
LICHESS_SYNC_COOLDOWN_RATE_LIMIT_SECONDS=900
OBSERVABILITY_RETENTION_DAYS=14
OBSERVABILITY_ADMIN_PASSPHRASE_SHA256=
# Which library the background crawler analyses (compose profile `crawl`).
# Set it here, not in the shell: a recreate without it exits 2 and restart-loops.
CRAWL_USERNAME=
