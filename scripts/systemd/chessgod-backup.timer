[Unit]
Description=Daily ChessGod database backup, caught up after sleep or a reboot

[Timer]
# Early morning local time; Persistent runs a missed one at the next boot.
OnCalendar=*-*-* 04:30:00
OnBootSec=10min
AccuracySec=5min
RandomizedDelaySec=10min
Persistent=true
Unit=chessgod-backup.service

[Install]
WantedBy=timers.target
